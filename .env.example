# --- Formulario de contato ---------------------------------------------------
# Chave publica do widget Cloudflare Turnstile (embutida no build)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Segredos configurados no Cloudflare Pages (nunca commitar valores reais)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Entrega das mensagens do formulario
CONTACT_TO_EMAIL=comercial@visiteconexoes.com.br
RESEND_FROM_EMAIL=site@send.visiteconexoes.com.br

# --- Rastreamento (briefing: Meta Pixel, GA4, GTM, Search Console) -----------
# Todos opcionais: sem o ID, o script correspondente nao e injetado.
# Definir no Cloudflare Pages -> Settings -> Environment variables e refazer o deploy.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta tag de verificacao do Google Search Console (alternativa ao registro DNS TXT)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
